#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Git pre-push hook for this repository. Enable it once per clone with
#
#     git config core.hooksPath .githooks
#
# It refuses the push when
#   1. the remote URL points at the course repository
#      (mlleo/inference-engine-study),
#   2. any blob in the commits being pushed is larger than 5 MB
#      (5,000,000 bytes), or
#   3. bash tools/prepublish_check.sh fails on the working tree.
#
# Bypass in an emergency only: git push --no-verify
set -euo pipefail

remote_name=${1:-}
remote_url=${2:-}
max_blob=5000000
zeros='^0+$'

url_lc=$(printf '%s' "$remote_url" | tr '[:upper:]' '[:lower:]')
case "$url_lc" in
  *mlleo/inference-engine-study*)
    echo "pre-push: refusing to push to the course repository ($remote_url)." >&2
    exit 1 ;;
esac

root=$(git rev-parse --show-toplevel)
cd "$root"

big=0
blobs=0
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [[ $local_sha =~ $zeros ]] && continue          # deleting a ref sends no objects
  if [[ $remote_sha =~ $zeros ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # New ref, or the remote tip is unknown here: check everything that is
    # not already on a remote-tracking ref of this remote.
    range=("$local_sha" --not --remotes="$remote_name")
  else
    range=("$remote_sha..$local_sha")
  fi
  while read -r type sha size path; do
    [ "$type" = blob ] || continue
    blobs=$((blobs + 1))
    if [ "$size" -gt "$max_blob" ]; then
      echo "pre-push: ${path:-$sha} is $size bytes (limit $max_blob) in $local_ref" >&2
      big=1
    fi
  done < <(git rev-list --objects "${range[@]}" |
           git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)')
done

if [ "$big" = 1 ]; then
  echo "pre-push: refusing: the push contains blobs over 5 MB (raw data belongs in the data-v1 release)." >&2
  exit 1
fi
echo "pre-push: $blobs blob(s) checked, none over 5 MB"

echo "pre-push: running tools/prepublish_check.sh"
if ! bash tools/prepublish_check.sh; then
  echo "pre-push: refusing: tools/prepublish_check.sh failed (see the table above)." >&2
  exit 1
fi
